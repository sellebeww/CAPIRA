{
  "name": "capira",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CAPIRA — Smart Capillary Refill Assessment. Offline-first PWA research prototype.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "analyze": "tsx scripts/analyze-csv.ts",
    "accuracy": "tsx scripts/synthetic-accuracy.ts",
    "compare": "tsx scripts/compare-annotations.ts",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
